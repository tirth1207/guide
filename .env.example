# Public client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public/client-safe Google configuration where applicable.
# Keep server-restricted keys out of the Expo bundle.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only secret. Do NOT add this to Expo client environment variables.
GEMINI_API_KEY=
